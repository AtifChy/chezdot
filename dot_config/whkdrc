.shell powershell

## Reload whkd configuration
# win + o                 : taskkill /f /im whkd.exe && start /b whkd # if shell is cmd
win + o                 : taskkill /f /im whkd.exe; Start-Process whkd -WindowStyle hidden # if shell is pwsh / powershell
win + shift + o         : komorebic reload-configuration

# Shortcut list
win + i                 : komorebic toggle-shortcuts

# App shortcuts - these require shell to be pwsh / powershell
# The apps will be focused if open, or launched if not open
# win + f                 : if ($wshell.AppActivate('Firefox') -eq $False) { start firefox }
# win + b                 : if ($wshell.AppActivate('Chrome') -eq $False) { start chrome }

## Basic shortcuts
win + q                 : komorebic close
win + m                 : komorebic minimize
alt + return            : komorebic toggle-maximize
# f11                     : komorebic toggle-maximize

## App shortcuts
win + return            : start $env:userprofile/scoop/apps/wezterm-nightly/current/wezterm-gui.exe

## Focus windows
win + h                 : komorebic focus left
win + j                 : komorebic focus down
win + k                 : komorebic focus up
win + l                 : komorebic focus right

win + left              : komorebic focus left
win + down              : komorebic focus down
win + up                : komorebic focus up
win + right             : komorebic focus right

win + oem_4             : komorebic cycle-focus previous # oem_4 is [
win + oem_6             : komorebic cycle-focus next # oem_6 is ]

## Move windows
win + shift + h         : komorebic move left
win + shift + j         : komorebic move down
win + shift + k         : komorebic move up
win + shift + l         : komorebic move right

win + shift + left      : komorebic move left
win + shift + down      : komorebic move down
win + shift + up        : komorebic move up
win + shift + right     : komorebic move right

win + shift + return    : komorebic promote

## Stack windows
win + ctrl + s          : komorebic stack-all
win + ctrl + left       : komorebic stack left
win + ctrl + down       : komorebic stack down
win + ctrl + up         : komorebic stack up
win + ctrl + right      : komorebic stack right
win + ctrl + oem_1      : komorebic unstack # oem_1 is ;
win + ctrl + oem_4      : komorebic cycle-stack previous # oem_4 is [
win + ctrl + oem_6      : komorebic cycle-stack next # oem_6 is ]

## Cycle layouts
win + shift + oem_4     : komorebic cycle-layout previous # oem_4 is [
win + shift + oem_6     : komorebic cycle-layout next # oem_6 is ]

## Resize
win + oem_plus          : komorebic resize-axis horizontal increase
win + oem_minus         : komorebic resize-axis horizontal decrease
win + shift + oem_plus  : komorebic resize-axis vertical increase
win + shift + oem_minus : komorebic resize-axis vertical decrease

## Manipulate windows
win + t                 : komorebic toggle-float
win + shift + f         : komorebic toggle-monocle
win + shift + m         : komorebic toggle-maximize

## Switch between workspace layer (Tiling/Floating)
win + shift + t         : komorebic toggle-workspace-layer

## Window manager options
win + shift + r         : komorebic retile
win + p                 : komorebic toggle-pause

## Layouts
win + x                 : komorebic flip-layout horizontal
win + y                 : komorebic flip-layout vertical

## Workspaces
win + 1                 : komorebic focus-workspace 0
win + 2                 : komorebic focus-workspace 1
win + 3                 : komorebic focus-workspace 2
win + 4                 : komorebic focus-workspace 3
win + 5                 : komorebic focus-workspace 4
win + 6                 : komorebic focus-workspace 5
win + 7                 : komorebic focus-workspace 6
win + 8                 : komorebic focus-workspace 7
win + tab               : komorebic focus-last-workspace
# win + oem_8             : komorebic focus-last-workspace # oem_8 is ` (varies)
win + prior             : komorebic cycle-workspace previous
win + next              : komorebic cycle-workspace next
win + alt + right       : komorebic cycle-workspace next
win + alt + left        : komorebic cycle-workspace previous

## Move windows across workspaces
win + shift + 1           : komorebic move-to-workspace 0
win + shift + 2           : komorebic move-to-workspace 1
win + shift + 3           : komorebic move-to-workspace 2
win + shift + 4           : komorebic move-to-workspace 3
win + shift + 5           : komorebic move-to-workspace 4
win + shift + 6           : komorebic move-to-workspace 5
win + shift + 7           : komorebic move-to-workspace 6
win + shift + 8           : komorebic move-to-workspace 7
win + alt + shift + right : komorebic cycle-move-to-workspace next
win + alt + shift + left  : komorebic cycle-move-to-workspace previous
