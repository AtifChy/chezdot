#!/usr/bin/zsh

emulate -L zsh -o local_options -o extended_glob

if (( ! $# >= 2 )); then
  print -r -- "Usage: ${0:A:t} [--regen] name cmd args..." >&2
  return 1
fi

local -i regen=0
if [[ $1 == --regen ]]; then
  regen=1; shift
fi

local name=$1; shift
local cmd=$1; shift

local cmdpath=${commands[$cmd]}
if [[ -z $cmdpath ]]; then
  print -r -- "${0:A:t}: command not found: $cmd" >&2
  return 1
fi

local cachefile=${XDG_CACHE_HOME:-$HOME/.cache}/zsh/lazy-eval/${name}.zsh
[[ -s $cachefile ]] || mkdir -p ${cachefile:h}

local -i current_mtime
zstat -A stats -L +mtime $cmdpath
current_mtime=${stats[1]:-0}

local -i cached_mtime
if (( regen )) && [[ -r $cachefile ]]; then
  local header
  read -r header < $cachefile
  if [[ $header =~ ^#\ MTIME:([0-9]+)$ ]]; then
    cached_mtime=${match[1]}
  fi
fi

if [[ ! -s $cachefile ]] || (( regen && current_mtime != cached_mtime )); then
  {
    print -r -- "# MTIME:$current_mtime"
    "$cmd" "$@"
  } >| $cachefile
fi

source $cachefile

