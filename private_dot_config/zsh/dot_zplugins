# vi: ft=conf

#
# Prompt
#
romkatv/powerlevel10k

#
# Local plugins
#
$ZDOTDIR/plugins/keymap.zsh
$ZDOTDIR/plugins/title.zsh
$ZDOTDIR/plugins/xdg.zsh

#
# Completion
#
zsh-users/zsh-completions kind:fpath path:src
# iloveitaly/zsh-ai-completions kind:fpath path:completions

#
# AutoPair
#
hlissner/zsh-autopair kind:defer path:autopair.zsh post:post-autopair

#
# Abbreviations
#
AtifChy/zsh-mini-abbr

#
# Misc
#
AtifChy/zsh-you-should-use kind:defer post:post-you-should-use
mattmc3/zman kind:autoload path:functions
# psprint/zsh-sweep kind:path path:bin

#
# Zephyr
#
mattmc3/zephyr path:plugins/zfunctions
mattmc3/zephyr path:plugins/confd

#
# Local plugins
#
$ZDOTDIR/plugins/command-not-found.zsh
$ZDOTDIR/plugins/clipboard.zsh
$ZDOTDIR/plugins/fancy-ctrl-z.zsh
$ZDOTDIR/plugins/gpg-agent.zsh
$ZDOTDIR/plugins/git-abbr.zsh kind:defer

#
# ohmyzsh
#
ohmyzsh/ohmyzsh path:plugins/sudo post:post-sudo
ohmyzsh/ohmyzsh path:plugins/extract

#
# fish-like plugins
#
zsh-users/zsh-history-substring-search kind:defer post:post-history-substring-search
zsh-users/zsh-syntax-highlighting kind:defer post:post-syntax-highlighting
# zdharma-continuum/fast-syntax-highlighting kind:defer
zsh-users/zsh-autosuggestions kind:defer post:post-autosuggestions
