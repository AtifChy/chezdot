{
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/v0.1.37/schema.bar.json",
  "monitor": 0,
  "font_family": "Operator Mono SSm Lig Book",
  "height": 44,
  "font_size": 12,
  "theme": {
    "palette": "Base16",
    "name": "CatppuccinMocha",
    "accent": "Base0D"
  },
  "icon_scale": 1.3,
  "padding": {
    "horizontal": 10,
    "vertical": 10
  },
  "widget_spacing": 10,
  "transparency_alpha": 0,
  "margin": {
    "vertical": [
      5,
      0
    ],
    "horizontal": 5
  },
  "grouping": {
    "kind": "Widget",
    "style": "DefaultWithShadowB4O1S3",
    "transparency_alpha": 160,
    "rounding": 4
  },
  "left_widgets": [
    {
      "Komorebi": {
        "workspaces": {
          "enable": true,
          "hide_empty_workspaces": true,
          "display": "AllIconsAndText"
        },
        "layout": {
          "enable": true,
          "display": "Icon"
        },
        "focused_window": {
          "enable": true,
          "show_icon": true
        }
      }
    }
  ],
  "right_widgets": [
    {
      "Date": {
        "enable": true,
        "format": "DateMonthYear"
      }
    },
    {
      "Time": {
        "enable": true,
        "format": "TwelveHourWithoutSeconds",
        "changing_icon": true
      }
    },
    {
      "Battery": {
        "enable": true
      }
    }
  ]
}
