#
# ~/.bashrc
#

# shellcheck disable=SC2139,SC1090

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

HISTFILE="${XDG_STATE_HOME:-$HOME/.local/state}/bash/history"
mkdir -p "${HISTFILE%/*}"

HISTCONTROL="erasedups:ignoreboth"

# bash settings
shopt -s autocd
shopt -s checkwinsize

# prompt
if oh-my-posh &>/dev/null; then
  export POSH_THEME="${XDG_CONFIG_HOME:-$HOME/.config}/oh-my-posh/mytheme.omp.yaml"
  source <(oh-my-posh init bash)
fi

# aliases
if command -v eza &>/dev/null; then
  LS_CMD='eza --color=auto --icons=auto --git --group-directories-first'
else
  LS_CMD='ls --color=auto --group-directories-first'
fi

alias ls="$LS_CMD"
alias la="$LS_CMD -a"
alias ll="$LS_CMD -alh"
alias l="$LS_CMD -CF"

alias grep='grep --color=auto'

# prompt
PS1='[\u@\h \W]\$ '

# bindings
bind '"\e[A": history-search-backward'
bind '"\e[B": history-search-forward'

# command not found handler
if command -v filkoll &>/dev/null; then
  source /usr/share/doc/filkoll/command-not-found.bash
fi

# zoxide init
source <(zoxide init bash)
